# Nexus - example environment file
#
# Copy to .env and fill in the keys you actually need. .env is gitignored;
# .env.example (this file) is committed. Never commit real secrets.
#
# These are NOT needed on day one. You fill them in as you wire up real tools
# (a graduation step), not at setup time. Transparency lives in the markdown;
# secrets stay local in .env and never get committed.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
GITHUB_TOKEN=
